{
  "name": "noyau",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@noyau/web",
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14"
}
