{
  "name": "noyau",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@noyau/web",
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint --deny-warnings",
    "lint:fix": "vp lint --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.4",
    "@types/bun": "^1.3.14",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/sql-pglite": "4.0.0-beta.107",
    "@effect/vitest": "4.0.0-beta.107",
    "effect": "4.0.0-beta.107",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10",
    "vite-plus": "0.2.9"
  }
}
