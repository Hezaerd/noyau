{
  "name": "noyau",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "node apps/desktop/scripts/dev-stack.ts",
    "dev:desktop": "node apps/desktop/scripts/dev-stack.ts",
    "dev:server": "node --watch apps/server/src/main.ts",
    "dev:web": "vp -C apps/web dev",
    "build": "vp run -r --cache build",
    "check": "vp check && vp run -r --cache typecheck",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "test": "vp run -r --cache test",
    "test:desktop-smoke": "vp run --filter @noyau/desktop smoke-test",
    "dist:desktop:mac": "vp run --filter @noyau/desktop package:mac",
    "dist:desktop:mac:dmg": "vp run --filter @noyau/desktop package:mac:dmg",
    "dist:desktop:win": "vp run --filter @noyau/desktop package:win",
    "dist:desktop:win:nsis": "vp run --filter @noyau/desktop package:win:nsis",
    "typecheck": "vp run -r --cache typecheck",
    "prepare": "vp config --no-agent && effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@effect/tsgo": "0.36.4",
    "@oxlint/plugins": "1.73.0",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/openapi-generator": "4.0.0-beta.107",
    "@effect/platform-node": "4.0.0-beta.107",
    "@effect/vitest": "4.0.0-beta.107",
    "effect": "4.0.0-beta.107",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vitest": "4.1.10",
    "vite-plus": "0.2.9"
  }
}
