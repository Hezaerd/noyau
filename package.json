{
  "name": "noyau",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@noyau/web",
    "build": "turbo run build",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint apps packages --deny-warnings --no-error-on-unmatched-pattern",
    "lint:fix": "oxlint apps packages --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.4",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "effect": "4.0.0-beta.107"
  }
}
