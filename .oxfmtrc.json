{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "sortImports": true,
  "ignorePatterns": [
    "**/dist/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/routeTree.gen.ts",
    "bun.lock",
    "docs/**"
  ]
}
