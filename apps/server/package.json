{
  "name": "@noyau/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./config": "./src/config.ts",
    "./control-plane": "./src/control-plane.ts",
    "./identity": "./src/identity.ts",
    "./observability": "./src/observability.ts",
    "./rpc-handlers": "./src/rpc-handlers.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --outdir dist --target=bun",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vp test run"
  },
  "dependencies": {
    "@effect/platform-bun": "catalog:",
    "@noyau/database": "workspace:*",
    "@noyau/domain": "workspace:*",
    "@noyau/protocol": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
