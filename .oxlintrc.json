{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/routeTree.gen.ts",
    "repos/**"
  ],
  "rules": {
    "import/no-cycle": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error"
  }
}
